{
  "name": "pi-studio",
  "version": "0.14.0",
  "description": "Pi Studio · Desktop — Electron operator console: hosts the Pi agent runtime, exposes the tool gateway to the control plane, sandbox provider, routines, shared memory",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check:text": "node scripts/check-text-encoding.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --ext .ts,.tsx src tests",
    "check": "pnpm run check:text && pnpm run typecheck && pnpm run test && pnpm run lint",
    "verify": "pnpm run check && pnpm run build",
    "eval": "node scripts/run-eval.mjs",
    "preview": "electron-vite preview",
    "package": "pnpm run verify && electron-builder --win --publish always",
    "package:mac": "pnpm run verify && electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "pnpm run verify && electron-builder --win --publish always",
    "release:local": "node scripts/release-local.js",
    "release:dry": "node scripts/release-local.js --dry-run --skip-build",
    "release:verify": "node scripts/release-local.js --verify-only --smoke-runtime",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke": "node scripts/smoke-launch.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "electron-updater": "^6.8.3",
    "qrcode.react": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@lobehub/ui": "^5.14.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "dayjs": "^1.11.21",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "happy-dom": "^20.12.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.jiubingwangwang.pi-studio",
    "productName": "pi-studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "build/icon.ico",
      "build/icon.png",
      "!**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.{md,markdown,txt}",
      "!node_modules/**/{LICENSE,LICENSE.*,license,CHANGELOG.md,README.md}",
      "resources/pi-skills/**",
      "resources/pi-extensions/**",
      "resources/model-export/**",
      "resources/pi-subagent/**",
      "node_modules/@earendil-works/pi-coding-agent/examples/extensions/subagent/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "GreenBeanLiu",
      "repo": "pi-studio-desktop",
      "releaseType": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/electron/electron/releases/download/"
    }
  },
  "type": "module",
  "packageManager": "pnpm@10.6.1"
}
