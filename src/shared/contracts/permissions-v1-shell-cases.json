{
  "contract": "permissions/v1",
  "description": "Conformance suite for shell_classifier. Every implementation (control plane Python, desktop TypeScript) must map each command to exactly this permission; the command is trimmed first and an empty command is an error.",
  "cases": [
    {"command": "pwd", "permission": "shell_read"},
    {"command": "  PWD  ", "permission": "shell_read"},
    {"command": "git status", "permission": "shell_read"},
    {"command": "git  status --short --branch", "permission": "shell_read"},
    {"command": "git status --porcelain=v2", "permission": "shell_read"},
    {"command": "git status -sb", "permission": "destructive_command"},
    {"command": "git status --long", "permission": "destructive_command"},
    {"command": "pwd; rm -rf /", "permission": "destructive_command"},
    {"command": "echo $(id)", "permission": "destructive_command"},
    {"command": "cat file > out", "permission": "destructive_command"},
    {"command": "rm -rf build", "permission": "destructive_command"},
    {"command": "sudo rm -fr /tmp/x", "permission": "destructive_command"},
    {"command": "git reset --hard HEAD~1", "permission": "destructive_command"},
    {"command": "git clean -fd", "permission": "destructive_command"},
    {"command": "DROP TABLE users", "permission": "destructive_command"},
    {"command": "format C:", "permission": "destructive_command"},
    {"command": "./deploy.sh", "permission": "production_deploy"},
    {"command": "deploy", "permission": "production_deploy"},
    {"command": "wrangler deploy", "permission": "production_deploy"},
    {"command": "kubectl apply -f k.yaml", "permission": "production_deploy"},
    {"command": "terraform apply", "permission": "production_deploy"},
    {"command": "systemctl restart nginx", "permission": "production_deploy"},
    {"command": "redeploy.sh", "permission": "destructive_command"},
    {"command": "git push", "permission": "git_push"},
    {"command": "git push --force origin main", "permission": "git_push"},
    {"command": "git pushx", "permission": "destructive_command"},
    {"command": "gh pr create --fill", "permission": "pull_request"},
    {"command": "gh pr merge 12", "permission": "pull_request"},
    {"command": "gh pr view 12", "permission": "destructive_command"},
    {"command": "npm test", "permission": "destructive_command"},
    {"command": "ls -la", "permission": "destructive_command"},
    {"command": "git diff --stat", "permission": "destructive_command"},
    {"command": "rm -rf build && git push", "permission": "destructive_command"}
  ]
}
